---

<Layout
  title="Contact Us | Climb Himalayan"
  description="Get in touch with Climb Himalayan for inquiries about our trekking, expedition, and climbing packages. We're here to help plan your Himalayan adventure."
>
  <Header transparent />
  
  <main>
    <!-- Hero Section -->
    <section class="relative h-[50vh] min-h-[350px] w-full overflow-hidden">
      <div
        class="absolute inset-0 bg-cover bg-center"
        style="background-image: url('https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?w=1920&q=80')"
      >
      </div>
      <div class="absolute inset-0 bg-gradient-to-b from-black/50 via-black/30 to-black/70"></div>
      
      <div class="absolute inset-0 flex flex-col items-center justify-center px-4 text-center text-white">
        <nav class="mb-6 text-sm">
          <ol class="flex items-center justify-center gap-2">
            <li>
              <a href="/" class="text-gray-300 hover:text-white transition-colors">Home</a>
            </li>
            <li class="text-gray-400">/</li>
            <li class="text-accent font-medium">Contact</li>
          </ol>
        </nav>
        <h1 class="text-4xl font-bold tracking-tight sm:text-5xl md:text-6xl">
          Get In Touch
        </h1>
        <p class="mt-4 max-w-2xl text-lg text-gray-200 sm:text-xl">
          Ready to start your Himalayan adventure? We'd love to hear from you.
        </p>
      </div>
    </section>

    <!-- Contact Section -->
    <section class="bg-white py-20 lg:py-28">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="grid gap-16 lg:grid-cols-3">
          
          <!-- Contact Info Sidebar -->
          <div class="lg:col-span-1">
            <span class="text-sm font-semibold uppercase tracking-widest text-accent">
              Contact Information
            </span>
            <h2 class="mt-2 text-2xl font-bold tracking-tight text-gray-900">
              Let's Start a Conversation
            </h2>
            <p class="mt-4 text-gray-600">
              Have questions about a package? Want to plan a custom trip? Just want to say hello? We're here to help.
            </p>

            <div class="mt-8 space-y-6">
              {contactInfo.map((item) => (
                <div class="flex items-start gap-4">
                  <div class="flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-xl bg-accent/10">
                    <svg class="h-6 w-6 text-accent" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" d={item.icon} />
                    </svg>
                  </div>
                  <div>
                    <h3 class="font-semibold text-gray-900">{item.title}</h3>
                    {item.link ? (
                      <a href={item.link} class="text-gray-600 hover:text-accent transition-colors whitespace-pre-line">
                        {item.content}
                      </a>
                    ) : (
                      <p class="text-gray-600 whitespace-pre-line">{item.content}</p>
                    )}
                  </div>
                </div>
              ))}
            </div>

            <!-- Social Links -->
            <div class="mt-10">
              <h3 class="font-semibold text-gray-900">Follow Us</h3>
              <div class="mt-4 flex gap-4">
                {socialLinks.map((social) => (
                  <a
                    href={social.href}
                    class="flex h-10 w-10 items-center justify-center rounded-full bg-gray-100 text-gray-600 transition-all hover:bg-accent hover:text-white"
                    aria-label={social.name}
                  >
                    <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
                      <path d={social.icon} />
                    </svg>
                  </a>
                ))}
              </div>
            </div>

            <!-- Response Time Badge -->
            <div class="mt-10 rounded-xl bg-green-50 p-4">
              <div class="flex items-center gap-3">
                <svg class="h-6 w-6 text-green-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <div>
                  <p class="font-semibold text-green-800">Quick Response</p>
                  <p class="text-sm text-green-700">We typically respond within 24 hours</p>
                </div>
              </div>
            </div>
          </div>

          <!-- Contact Form -->
          <div class="lg:col-span-2">
            <div class="rounded-2xl bg-gray-50 p-8 lg:p-10">
              <h2 class="text-2xl font-bold tracking-tight text-gray-900 mb-2">
                Send Us a Message
              </h2>
              <p class="text-gray-600 mb-8">
                Fill out the form below and we'll get back to you as soon as possible.
              </p>
              <ContactForm />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ CTA -->
    <section class="bg-gray-50 py-20 lg:py-28">
      <div class="mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
        <span class="text-sm font-semibold uppercase tracking-widest text-accent">
          Need Help?
        </span>
        <h2 class="mt-4 text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">
          Looking for Quick Answers?
        </h2>
        <p class="mt-4 text-lg text-gray-600">
          Check out our package pages for detailed FAQs about specific trips, or browse our packages to find your perfect adventure.
        </p>
        <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
          <Button href="/packages" variant="primary" size="lg">
            Browse Packages
          </Button>
          <Button href="/" variant="outline" size="lg">
            Back to Home
          </Button>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
