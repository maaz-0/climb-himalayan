---
import Layout from '../layouts/Layout.astro';
import Header from '../components/common/Header.astro';
import Footer from '../components/common/Footer.astro';
import Button from '../components/common/Button.astro';

const values = [
  {
    title: 'Safety First',
    description: 'Your safety is our top priority. All our guides are certified in wilderness first aid and we maintain strict safety protocols on every expedition.',
    icon: 'M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z',
  },
  {
    title: 'Local Expertise',
    description: 'Born and raised in the shadows of the Himalayas, our team has unparalleled knowledge of the mountains, trails, and local culture.',
    icon: 'M15 10.5a3 3 0 11-6 0 3 3 0 016 0z M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z',
  },
  {
    title: 'Authentic Experiences',
    description: 'We go beyond the tourist trails to offer genuine cultural immersion and connections with local communities along the way.',
    icon: 'M12 21v-8.25M15.75 21v-8.25M8.25 21v-8.25M3 9l9-6 9 6m-1.5 12V10.332A48.36 48.36 0 0012 9.75c-2.551 0-5.056.2-7.5.582V21M3 21h18M12 6.75h.008v.008H12V6.75z',
  },
  {
    title: 'Sustainable Tourism',
    description: 'We\'re committed to preserving the pristine beauty of the Himalayas. Our trips follow Leave No Trace principles and support local conservation.',
    icon: 'M12.75 3.03v.568c0 .334.148.65.405.864l1.068.89c.442.369.535 1.01.216 1.49l-.51.766a2.25 2.25 0 01-1.161.886l-.143.048a1.107 1.107 0 00-.57 1.664c.369.555.169 1.307-.427 1.605L9 13.125l.423 1.059a.956.956 0 01-1.652.928l-.679-.906a1.125 1.125 0 00-1.906.172L4.5 15.75l-.612.153M12.75 3.031a9 9 0 00-8.862 12.872M12.75 3.031a9 9 0 016.69 14.036m0 0l-.177-.529A2.25 2.25 0 0017.128 15H16.5l-.324-.324a1.453 1.453 0 00-2.328.377l-.036.073a1.586 1.586 0 01-.982.816l-.99.282c-.55.157-.894.702-.8 1.267l.073.438c.08.474.49.821.97.821.846 0 1.598.542 1.865 1.345l.215.643m5.276-3.67a9.012 9.012 0 01-5.276 3.67m0 0a9 9 0 01-10.275-4.835M15.75 9c0 .896-.393 1.7-1.016 2.25',
  },
  {
    title: 'Small Groups',
    description: 'With a maximum of 12 trekkers per group, we ensure personalized attention, deeper connections, and minimal environmental impact.',
    icon: 'M18 18.72a9.094 9.094 0 003.741-.479 3 3 0 00-4.682-2.72m.94 3.198l.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0112 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 016 18.719m12 0a5.971 5.971 0 00-.941-3.197m0 0A5.995 5.995 0 0012 12.75a5.995 5.995 0 00-5.058 2.772m0 0a3 3 0 00-4.681 2.72 8.986 8.986 0 003.74.477m.94-3.197a5.971 5.971 0 00-.94 3.197M15 6.75a3 3 0 11-6 0 3 3 0 016 0z',
  },
  {
    title: '24/7 Support',
    description: 'From your first inquiry to your safe return home, our team is available around the clock to assist you with anything you need.',
    icon: 'M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z',
  },
];

const nepalFacts = [
  { number: '8', label: 'of the world\'s 14 highest peaks are in Nepal' },
  { number: '1000+', label: 'years of Buddhist and Hindu heritage' },
  { number: '125+', label: 'ethnic groups and languages' },
  { number: '∞', label: 'unforgettable memories await' },
];
---

<Layout
  title="About Us | Climb Himalayan"
  description="Learn about Climb Himalayan - your trusted partner for Himalayan adventures since 2005. Based in Kathmandu, serving adventurers from US and Canada."
>
  <Header transparent />
  
  <main>
    <!-- Hero Section -->
    <section class="relative h-[60vh] min-h-[400px] w-full overflow-hidden">
      <div
        class="absolute inset-0 bg-cover bg-center"
        style="background-image: url('https://images.unsplash.com/photo-1506905925346-21bda4d32df4?w=1920&q=80')"
      >
      </div>
      <div class="absolute inset-0 bg-gradient-to-b from-black/50 via-black/30 to-black/70"></div>
      
      <div class="absolute inset-0 flex flex-col items-center justify-center px-4 text-center text-white">
        <nav class="mb-6 text-sm">
          <ol class="flex items-center justify-center gap-2">
            <li>
              <a href="/" class="text-gray-300 hover:text-white transition-colors">Home</a>
            </li>
            <li class="text-gray-400">/</li>
            <li class="text-accent font-medium">About Us</li>
          </ol>
        </nav>
        <h1 class="text-4xl font-bold tracking-tight sm:text-5xl md:text-6xl">
          About Climb Himalayan
        </h1>
        <p class="mt-4 max-w-2xl text-lg text-gray-200 sm:text-xl">
          Your gateway to the roof of the world since 2005
        </p>
      </div>
    </section>

    <!-- Our Story Section -->
    <section class="bg-white py-20 lg:py-28">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="grid gap-12 lg:grid-cols-2 lg:gap-16 items-center">
          <div>
            <span class="text-sm font-semibold uppercase tracking-widest text-accent">
              Our Story
            </span>
            <h2 class="mt-2 text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">
              Born in the Heart of the Himalayas
            </h2>
            <div class="mt-6 space-y-4 text-lg text-gray-600">
              <p>
                Climb Himalayan was founded in 2005 in Kathmandu, Nepal by a team of passionate mountaineers and trekking enthusiasts who wanted to share the magic of the Himalayas with the world.
              </p>
              <p>
                What started as a small team of local guides has grown into a full-service adventure company, but our mission remains the same: to provide safe, authentic, and life-changing experiences in the world's greatest mountain range.
              </p>
              <p>
                Today, we specialize in serving adventurers from the United States and Canada, offering everything from gentle teahouse treks to technical summit expeditions. Our team of 25+ guides, porters, and support staff are all locals who know these mountains like the back of their hands.
              </p>
            </div>
            <div class="mt-8 flex flex-wrap gap-8">
              <div>
                <span class="text-4xl font-bold text-accent">20+</span>
                <p class="text-sm text-gray-600">Years of Experience</p>
              </div>
              <div>
                <span class="text-4xl font-bold text-accent">5,000+</span>
                <p class="text-sm text-gray-600">Happy Adventurers</p>
              </div>
              <div>
                <span class="text-4xl font-bold text-accent">100%</span>
                <p class="text-sm text-gray-600">Safety Record</p>
              </div>
            </div>
          </div>
          <div class="relative">
            <div class="aspect-[4/5] overflow-hidden rounded-2xl">
              <img
                src="https://images.unsplash.com/photo-1551632811-561732d1e306?w=800&q=80"
                alt="Trekking team in the Himalayas"
                class="h-full w-full object-cover"
              />
            </div>
            <div class="absolute -bottom-6 -left-6 rounded-2xl bg-accent p-6 text-white shadow-xl">
              <p class="text-sm font-medium uppercase tracking-wider">Established</p>
              <p class="text-3xl font-bold">2005</p>
              <p class="text-sm">Kathmandu, Nepal</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Mission & Values Section -->
    <section class="bg-gray-50 py-20 lg:py-28">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="mx-auto max-w-2xl text-center">
          <span class="text-sm font-semibold uppercase tracking-widest text-accent">
            What We Stand For
          </span>
          <h2 class="mt-2 text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">
            Our Values
          </h2>
          <p class="mt-4 text-lg text-gray-600">
            These principles guide everything we do, from planning your trip to guiding you on the trail.
          </p>
        </div>

        <div class="mt-16 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
          {values.map((value) => (
            <div class="group rounded-2xl bg-white p-8 shadow-card transition-all duration-300 hover:shadow-card-hover hover:bg-primary">
              <div class="mb-4 flex h-14 w-14 items-center justify-center rounded-xl bg-accent/10 transition-colors group-hover:bg-white/20">
                <svg
                  class="h-7 w-7 text-accent transition-colors group-hover:text-white"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke-width="1.5"
                  stroke="currentColor"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" d={value.icon} />
                </svg>
              </div>
              <h3 class="mb-2 text-lg font-bold text-gray-900 transition-colors group-hover:text-white">
                {value.title}
              </h3>
              <p class="text-sm leading-relaxed text-gray-600 transition-colors group-hover:text-gray-200">
                {value.description}
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Why Nepal Section -->
    <section class="bg-primary py-20 lg:py-28">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="grid gap-12 lg:grid-cols-2 lg:gap-16 items-center">
          <div>
            <span class="text-sm font-semibold uppercase tracking-widest text-accent">
              The Ultimate Destination
            </span>
            <h2 class="mt-2 text-3xl font-bold tracking-tight text-white sm:text-4xl">
              Why Nepal?
            </h2>
            <div class="mt-6 space-y-4 text-lg text-gray-300">
              <p>
                Nepal is not just a destination—it's a spiritual journey. Home to the mighty Himalayas, ancient temples, and some of the warmest people on Earth, Nepal offers experiences that touch the soul.
              </p>
              <p>
                From the bustling streets of Kathmandu to the serene trails of the Everest region, every step in Nepal reveals something extraordinary. The blend of Hindu and Buddhist traditions, the vibrant festivals, and the unwavering hospitality of the Nepali people create memories that last a lifetime.
              </p>
              <p>
                Whether you're seeking the thrill of standing at the base of the world's highest peak or the peace of a monastery perched high in the mountains, Nepal delivers it all.
              </p>
            </div>
          </div>
          <div class="grid grid-cols-2 gap-4">
            {nepalFacts.map((fact) => (
              <div class="rounded-2xl bg-white/10 p-6 text-center backdrop-blur-sm">
                <span class="block text-4xl font-bold text-accent">{fact.number}</span>
                <span class="mt-2 block text-sm text-gray-300">{fact.label}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Team Section -->
    <section class="bg-white py-20 lg:py-28">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="mx-auto max-w-2xl text-center">
          <span class="text-sm font-semibold uppercase tracking-widest text-accent">
            The People Behind Your Adventure
          </span>
          <h2 class="mt-2 text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">
            Our Team
          </h2>
          <p class="mt-4 text-lg text-gray-600">
            Our team consists of experienced local guides, porters, and support staff who are passionate about sharing their homeland with you.
          </p>
        </div>

        <div class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
          <div class="group text-center">
            <div class="relative mx-auto h-48 w-48 overflow-hidden rounded-full">
              <img
                src="https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?w=400&q=80"
                alt="Head Guide"
                class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-110"
              />
            </div>
            <h3 class="mt-4 text-lg font-bold text-gray-900">Pemba Sherpa</h3>
            <p class="text-accent font-medium">Head Guide & Co-Founder</p>
            <p class="mt-2 text-sm text-gray-600">
              20+ years guiding experience, 8 Everest summits
            </p>
          </div>
          <div class="group text-center">
            <div class="relative mx-auto h-48 w-48 overflow-hidden rounded-full">
              <img
                src="https://images.unsplash.com/photo-1438761681033-6461ffad8d80?w=400&q=80"
                alt="Operations Manager"
                class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-110"
              />
            </div>
            <h3 class="mt-4 text-lg font-bold text-gray-900">Maya Tamang</h3>
            <p class="text-accent font-medium">Operations Manager</p>
            <p class="mt-2 text-sm text-gray-600">
              15 years in adventure tourism, logistics expert
            </p>
          </div>
          <div class="group text-center">
            <div class="relative mx-auto h-48 w-48 overflow-hidden rounded-full">
              <img
                src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=400&q=80"
                alt="Senior Guide"
                class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-110"
              />
            </div>
            <h3 class="mt-4 text-lg font-bold text-gray-900">Dorje Lama</h3>
            <p class="text-accent font-medium">Senior Expedition Guide</p>
            <p class="mt-2 text-sm text-gray-600">
              Technical climbing specialist, UIAGM certified
            </p>
          </div>
        </div>

        <div class="mt-12 text-center">
          <p class="text-gray-600">
            Plus 25+ experienced guides, porters, and support staff ready to make your adventure unforgettable.
          </p>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="bg-gray-50 py-20 lg:py-28">
      <div class="mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
        <span class="text-sm font-semibold uppercase tracking-widest text-accent">
          Start Your Journey
        </span>
        <h2 class="mt-4 text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">
          Ready to Explore the Himalayas?
        </h2>
        <p class="mt-4 text-lg text-gray-600">
          Let us help you plan the adventure of a lifetime. Browse our packages or get in touch for a custom trip.
        </p>
        <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
          <Button href="/packages" variant="primary" size="lg">
            Browse Packages
          </Button>
          <Button href="/contact" variant="outline" size="lg">
            Contact Us
          </Button>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
