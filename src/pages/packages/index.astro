---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/common/Header.astro';
import Footer from '../../components/common/Footer.astro';
import Card from '../../components/common/Card.astro';
import Button from '../../components/common/Button.astro';
import { getCollection } from 'astro:content';

const packages = await getCollection('packages');

const categories = [
  { id: 'all', label: 'All Adventures' },
  { id: 'trekking', label: 'Trekking' },
  { id: 'expedition', label: 'Expeditions' },
  { id: 'climbing', label: 'Technical Climbing' },
];
---

<Layout
  title="Our Packages | Climb Himalayan"
  description="Explore our range of trekking, expedition, and technical climbing packages in the Himalayas. From beginner treks to challenging summits."
>
  <Header transparent />
  
  <main>
    <!-- Hero Section -->
    <section class="relative h-[60vh] min-h-[400px] w-full overflow-hidden">
      <div
        class="absolute inset-0 bg-cover bg-center"
        style="background-image: url('https://images.unsplash.com/photo-1454496522488-7a8e488e8606?w=1920&q=80')"
      >
      </div>
      <div class="absolute inset-0 bg-gradient-to-b from-black/50 via-black/30 to-black/70"></div>
      
      <div class="absolute inset-0 flex flex-col items-center justify-center px-4 text-center text-white">
        <nav class="mb-6 text-sm">
          <ol class="flex items-center justify-center gap-2">
            <li>
              <a href="/" class="text-gray-300 hover:text-white transition-colors">Home</a>
            </li>
            <li class="text-gray-400">/</li>
            <li class="text-accent font-medium">Packages</li>
          </ol>
        </nav>
        <h1 class="text-4xl font-bold tracking-tight sm:text-5xl md:text-6xl">
          Explore Our Adventures
        </h1>
        <p class="mt-4 max-w-2xl text-lg text-gray-200 sm:text-xl">
          From gentle treks through ancient villages to challenging summit expeditions, find your perfect Himalayan adventure.
        </p>
      </div>
    </section>

    <!-- Category Filter & Packages -->
    <section class="bg-gray-50 py-20 lg:py-28">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        
        <!-- Category Tabs -->
        <div class="mb-12 flex flex-wrap justify-center gap-3">
          {categories.map((category) => (
            <button
              type="button"
              class:list={[
                'category-tab rounded-full px-6 py-2.5 text-sm font-semibold transition-all duration-200',
                category.id === 'all'
                  ? 'bg-accent text-white shadow-lg'
                  : 'bg-white text-gray-700 hover:bg-gray-100 shadow-card',
              ]}
              data-category={category.id}
            >
              {category.label}
            </button>
          ))}
        </div>

        <!-- Packages Grid -->
        <div id="packages-grid" class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
          {packages.map((pkg) => (
            <div class="package-card" data-category={pkg.data.category}>
              <Card
                title={pkg.data.title}
                slug={pkg.data.slug || pkg.id.replace(/\.md$/, '')}
                category={pkg.data.category}
                heroImage={pkg.data.heroImage}
                duration={pkg.data.duration}
                difficulty={pkg.data.difficulty}
                shortDescription={pkg.data.shortDescription}
                price={pkg.data.price}
              />
            </div>
          ))}
        </div>

        <!-- No Results Message -->
        <div id="no-results" class="hidden py-16 text-center">
          <svg class="mx-auto h-16 w-16 text-gray-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" />
          </svg>
          <h3 class="mt-4 text-xl font-semibold text-gray-900">No packages found</h3>
          <p class="mt-2 text-gray-600">Try selecting a different category or contact us for custom trips.</p>
        </div>
      </div>
    </section>

    <!-- Custom Trip CTA -->
    <section class="bg-gray-50 py-20 lg:py-28">
      <div class="mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
        <span class="text-sm font-semibold uppercase tracking-widest text-accent">
          Can't Find What You're Looking For?
        </span>
        <h2 class="mt-4 text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">
          Let's Plan Your Custom Adventure
        </h2>
        <p class="mt-4 text-lg text-gray-600">
          Every adventurer is unique. Tell us about your dream trip and we'll craft a personalized itinerary just for you.
        </p>
        <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
          <Button href="/contact" variant="primary" size="lg">
            Plan Custom Trip
          </Button>
          <Button href="mailto:info@climbhimalayan.com" variant="outline" size="lg">
            Email Us
          </Button>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<script>
  const tabs = document.querySelectorAll('.category-tab');
  const cards = document.querySelectorAll('.package-card');
  const noResults = document.getElementById('no-results');

  function filterPackages(category: string) {
    let visibleCount = 0;

    cards.forEach((card) => {
      const cardCategory = card.getAttribute('data-category');
      const shouldShow = category === 'all' || cardCategory === category;
      
      if (shouldShow) {
        card.classList.remove('hidden');
        visibleCount++;
      } else {
        card.classList.add('hidden');
      }
    });

    // Show/hide no results message
    if (noResults) {
      noResults.classList.toggle('hidden', visibleCount > 0);
    }

    // Update active tab styling
    tabs.forEach((tab) => {
      const tabCategory = tab.getAttribute('data-category');
      if (tabCategory === category) {
        tab.classList.add('bg-accent', 'text-white', 'shadow-lg');
        tab.classList.remove('bg-white', 'text-gray-700', 'hover:bg-gray-100');
      } else {
        tab.classList.remove('bg-accent', 'text-white', 'shadow-lg');
        tab.classList.add('bg-white', 'text-gray-700', 'hover:bg-gray-100');
      }
    });
  }

  // Add click handlers
  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const category = tab.getAttribute('data-category') || 'all';
      filterPackages(category);
      
      // Update URL hash
      if (category === 'all') {
        history.replaceState(null, '', window.location.pathname);
      } else {
        history.replaceState(null, '', `?category=${category}`);
      }
    });
  });

  // Handle initial filter from URL
  const urlParams = new URLSearchParams(window.location.search);
  const initialCategory = urlParams.get('category') || 'all';
  filterPackages(initialCategory);
</script>
