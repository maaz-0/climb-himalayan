---
interface ItineraryDay {
  day: number;
  title: string;
  description: string;
}

interface Props {
  itinerary: ItineraryDay[];
}

const { itinerary } = Astro.props;
---

<section class="bg-white pt-10 pb-20 lg:pt-14 lg:pb-28">
  <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
    <div class="text-center">
      <span class="text-sm font-semibold uppercase tracking-widest text-accent">
        Day by Day
      </span>
      <h2 class="mt-2 text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">
        Detailed Itinerary
      </h2>
      <p class="mt-4 text-lg text-gray-600">
        Your journey from start to finish, day by day
      </p>
    </div>

    <div class="mt-12 space-y-4">
      {itinerary.map((day, index) => (
        <div
          class="itinerary-item group rounded-2xl border border-gray-200 bg-white transition-all duration-300 hover:border-accent/30 hover:shadow-lg"
          data-index={index}
        >
          <button
            type="button"
            class="itinerary-trigger flex w-full items-center gap-4 p-6 text-left"
            aria-expanded="false"
          >
            <div class="flex h-14 w-14 flex-shrink-0 items-center justify-center rounded-xl bg-accent text-white font-bold">
              <span class="text-xs uppercase">Day</span>
              <span class="ml-1 text-lg">{day.day}</span>
            </div>
            <div class="flex-1">
              <h3 class="text-lg font-bold text-gray-900 group-hover:text-accent transition-colors">
                {day.title}
              </h3>
            </div>
            <svg
              class="itinerary-icon h-6 w-6 flex-shrink-0 text-gray-400 transition-transform duration-300"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="2"
              stroke="currentColor"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
            </svg>
          </button>
          <div class="itinerary-content hidden px-6 pb-6">
            <div class="ml-[4.5rem] border-l-2 border-accent/20 pl-6">
              <p class="text-gray-600 leading-relaxed">
                {day.description}
              </p>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Expand All Button -->
    <div class="mt-8 text-center">
      <button
        type="button"
        id="expand-all-btn"
        class="inline-flex items-center gap-2 rounded-full border-2 border-accent px-6 py-2.5 text-sm font-semibold text-accent transition-all hover:bg-accent hover:text-white"
      >
        <span id="expand-all-text">Expand All Days</span>
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
        </svg>
      </button>
    </div>
  </div>
</section>

<script>
  const items = document.querySelectorAll('.itinerary-item');
  const expandAllBtn = document.getElementById('expand-all-btn');
  const expandAllText = document.getElementById('expand-all-text');
  let allExpanded = false;

  function toggleItem(item: Element, forceOpen?: boolean) {
    const trigger = item.querySelector('.itinerary-trigger');
    const content = item.querySelector('.itinerary-content');
    const icon = item.querySelector('.itinerary-icon');
    
    if (!trigger || !content || !icon) return;

    const isCurrentlyOpen = trigger.getAttribute('aria-expanded') === 'true';
    const shouldOpen = forceOpen !== undefined ? forceOpen : !isCurrentlyOpen;

    trigger.setAttribute('aria-expanded', shouldOpen.toString());
    
    if (shouldOpen) {
      content.classList.remove('hidden');
      icon.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" d="M19.5 12h-15" />';
    } else {
      content.classList.add('hidden');
      icon.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />';
    }
  }

  items.forEach((item) => {
    const trigger = item.querySelector('.itinerary-trigger');
    trigger?.addEventListener('click', () => toggleItem(item));
  });

  expandAllBtn?.addEventListener('click', () => {
    allExpanded = !allExpanded;
    items.forEach((item) => toggleItem(item, allExpanded));
    
    if (expandAllText) {
      expandAllText.textContent = allExpanded ? 'Collapse All Days' : 'Expand All Days';
    }
  });
</script>
