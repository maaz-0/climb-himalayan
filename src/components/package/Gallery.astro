---
import OptimizedImage from '../common/OptimizedImage.astro';

interface Props {
  images: string[];
  title: string;
}

const { images, title } = Astro.props;

// Generate meaningful alt text for gallery images
function getAltText(index: number): string {
  const contexts = [
    'Stunning mountain vista',
    'Trekkers on the trail',
    'Local village scenery',
    'Mountain sunrise view',
    'Camp setup with mountain backdrop',
    'Prayer flags in the wind',
    'Scenic landscape panorama',
    'Trail through the mountains',
  ];
  return `${title} - ${contexts[index % contexts.length]}`;
}
---

{images && images.length > 0 && (
  <section class="bg-gray-50 py-20 lg:py-28">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center">
        <span class="text-sm font-semibold uppercase tracking-widest text-accent">
          Visual Journey
        </span>
        <h2 class="mt-2 text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">
          Photo Gallery
        </h2>
        <p class="mt-4 text-lg text-gray-600">
          Get a glimpse of what awaits you on the {title}
        </p>
      </div>

      <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {images.map((image, index) => (
          <div
            class:list={[
              'group relative overflow-hidden rounded-2xl img-zoom',
              index === 0 ? 'sm:col-span-2 sm:row-span-2' : '',
            ]}
          >
            <OptimizedImage
              src={image}
              alt={getAltText(index)}
              width={index === 0 ? 1200 : 600}
              height={index === 0 ? 800 : 600}
              class:list={[
                'w-full object-cover img-zoom-target',
                index === 0 ? 'h-full' : 'aspect-square',
              ]}
              loading={index < 2 ? 'eager' : 'lazy'}
              aspectRatio={index === 0 ? '3/2' : '1/1'}
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100">
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
)}
