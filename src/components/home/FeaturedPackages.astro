---
import { getCollection } from 'astro:content';
import Card from '../common/Card.astro';
import Button from '../common/Button.astro';

const allPackages = await getCollection('packages');
const featuredPackages = allPackages
  .filter((pkg) => pkg.data.featured)
  .slice(0, 4);
---

<section class="bg-gray-50 py-20 lg:py-28">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="mx-auto max-w-2xl text-center">
      <span
        class="text-sm font-semibold uppercase tracking-widest text-accent"
      >
        Popular Adventures
      </span>
      <h2 class="mt-2 text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">
        Featured Packages
      </h2>
      <p class="mt-4 text-lg text-gray-600">
        Our most sought-after adventures, chosen by travelers from around the
        world.
      </p>
    </div>

    <!-- Packages Grid -->
    <div class="mt-16 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
      {
        featuredPackages.map((pkg) => (
          <Card
            title={pkg.data.title}
            slug={pkg.id.replace(/\.md$/, '')}
            category={pkg.data.category}
            heroImage={pkg.data.heroImage}
            duration={pkg.data.duration}
            difficulty={pkg.data.difficulty}
            shortDescription={pkg.data.shortDescription}
            price={pkg.data.price}
          />
        ))
      }
    </div>

    <!-- View All Link -->
    <div class="mt-12 text-center">
      <Button href="/packages" variant="secondary" size="lg">
        View All Packages
      </Button>
    </div>
  </div>
</section>
