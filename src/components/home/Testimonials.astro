---
import { getEntry } from 'astro:content';
import ScrollReveal from '../common/ScrollReveal.astro';

const testimonialsData = await getEntry('testimonials', 'testimonials');
const testimonials = testimonialsData?.data.testimonials || [];
---

<section class="bg-white py-20 lg:py-28">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <ScrollReveal animation="fade-up">
      <div class="mx-auto max-w-2xl text-center">
        <span
          class="text-sm font-semibold uppercase tracking-widest text-accent"
        >
          Testimonials
        </span>
        <h2 class="mt-2 text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">
          What Our Adventurers Say
        </h2>
        <p class="mt-4 text-lg text-gray-600">
          Don't just take our word for it - hear from travelers who've experienced
          the Himalayas with us.
        </p>
      </div>
    </ScrollReveal>

    <!-- Testimonials Carousel -->
    <div class="relative mt-16">
      <!-- Carousel Container -->
      <div id="testimonials-carousel" class="overflow-hidden">
        <div
          id="testimonials-track"
          class="flex transition-transform duration-500 ease-out"
        >
          {
            testimonials.map((testimonial, index) => (
              <div
                class="w-full flex-shrink-0 px-4 md:w-1/2 lg:w-1/3"
                data-index={index}
              >
                <div class="relative rounded-2xl bg-gray-50 p-8 h-full">
                  {/* Quote Mark */}
                  <svg
                    class="absolute right-6 top-6 h-12 w-12 text-accent/10"
                    fill="currentColor"
                    viewBox="0 0 32 32"
                  >
                    <path d="M9.352 4C4.456 7.456 1 13.12 1 19.36c0 5.088 3.072 8.064 6.624 8.064 3.36 0 5.856-2.688 5.856-5.856 0-3.168-2.208-5.472-5.088-5.472-.576 0-1.344.096-1.536.192.48-3.264 3.552-7.104 6.624-9.024L9.352 4zm16.512 0c-4.8 3.456-8.256 9.12-8.256 15.36 0 5.088 3.072 8.064 6.624 8.064 3.264 0 5.856-2.688 5.856-5.856 0-3.168-2.304-5.472-5.184-5.472-.576 0-1.248.096-1.44.192.48-3.264 3.456-7.104 6.528-9.024L25.864 4z" />
                  </svg>

                  {/* Stars */}
                  <div class="mb-4 flex gap-1">
                    {Array.from({ length: testimonial.rating }).map(() => (
                      <svg
                        class="h-5 w-5 text-yellow-400"
                        fill="currentColor"
                        viewBox="0 0 20 20"
                      >
                        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                      </svg>
                    ))}
                  </div>

                  {/* Quote */}
                  <blockquote class="mb-6 text-gray-700 leading-relaxed">
                    "{testimonial.quote}"
                  </blockquote>

                  {/* Author */}
                  <div class="flex items-center gap-4">
                    {testimonial.image && (
                      <img
                        src={testimonial.image}
                        alt={testimonial.name}
                        class="h-12 w-12 rounded-full object-cover"
                      />
                    )}
                    <div>
                      <p class="font-semibold text-gray-900">
                        {testimonial.name}
                      </p>
                      <p class="text-sm text-gray-500">
                        {testimonial.location} - {testimonial.trip}
                      </p>
                    </div>
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>

      <!-- Navigation Arrows -->
      <button
        id="prev-btn"
        type="button"
        class="absolute -left-4 top-1/2 z-10 -translate-y-1/2 rounded-full bg-white p-3 shadow-lg transition-all hover:bg-gray-50 hover:shadow-xl focus:outline-none focus:ring-2 focus:ring-accent hidden lg:block"
        aria-label="Previous testimonial"
      >
        <svg
          class="h-6 w-6 text-gray-700"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="2"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M15.75 19.5L8.25 12l7.5-7.5"></path>
        </svg>
      </button>
      <button
        id="next-btn"
        type="button"
        class="absolute -right-4 top-1/2 z-10 -translate-y-1/2 rounded-full bg-white p-3 shadow-lg transition-all hover:bg-gray-50 hover:shadow-xl focus:outline-none focus:ring-2 focus:ring-accent hidden lg:block"
        aria-label="Next testimonial"
      >
        <svg
          class="h-6 w-6 text-gray-700"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="2"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M8.25 4.5l7.5 7.5-7.5 7.5"></path>
        </svg>
      </button>

      <!-- Dots Navigation -->
      <div class="mt-8 flex justify-center gap-3">
        {
          testimonials.map((_, index) => (
            <button
              type="button"
              class:list={[
                'testimonial-dot h-4 w-4 rounded-full transition-all duration-300 focus-ring',
                index === 0 ? 'bg-accent w-8' : 'bg-gray-300 hover:bg-gray-400',
              ]}
              data-index={index}
              aria-label={`Go to testimonial ${index + 1}`}
            />
          ))
        }
      </div>
    </div>
  </div>
</section>

<script define:vars={{ totalSlides: testimonials.length }}>
  const track = document.getElementById('testimonials-track');
  const prevBtn = document.getElementById('prev-btn');
  const nextBtn = document.getElementById('next-btn');
  const dots = document.querySelectorAll('.testimonial-dot');

  let currentIndex = 0;
  let slidesPerView = 1;

  function updateSlidesPerView() {
    if (window.innerWidth >= 1024) {
      slidesPerView = 3;
    } else if (window.innerWidth >= 768) {
      slidesPerView = 2;
    } else {
      slidesPerView = 1;
    }
  }

  function goToSlide(index) {
    const maxIndex = Math.max(0, totalSlides - slidesPerView);
    currentIndex = Math.min(Math.max(0, index), maxIndex);

    const slideWidth = 100 / slidesPerView;
    const offset = currentIndex * slideWidth;
    if (track) {
      track.style.transform = `translateX(-${offset}%)`;
    }

    // Update dots
    dots.forEach((dot, i) => {
      if (i === currentIndex) {
        dot.classList.add('bg-accent', 'w-8');
        dot.classList.remove('bg-gray-300');
      } else {
        dot.classList.remove('bg-accent', 'w-8');
        dot.classList.add('bg-gray-300');
      }
    });
  }

  function nextSlide() {
    const maxIndex = Math.max(0, totalSlides - slidesPerView);
    if (currentIndex < maxIndex) {
      goToSlide(currentIndex + 1);
    } else {
      goToSlide(0);
    }
  }

  function prevSlide() {
    if (currentIndex > 0) {
      goToSlide(currentIndex - 1);
    } else {
      const maxIndex = Math.max(0, totalSlides - slidesPerView);
      goToSlide(maxIndex);
    }
  }

  // Event listeners
  prevBtn?.addEventListener('click', prevSlide);
  nextBtn?.addEventListener('click', nextSlide);

  dots.forEach((dot, index) => {
    dot.addEventListener('click', () => goToSlide(index));
  });

  // Update on resize
  window.addEventListener('resize', () => {
    updateSlidesPerView();
    goToSlide(currentIndex);
  });

  // Initialize
  updateSlidesPerView();

  // Auto-play
  let autoplayInterval = setInterval(nextSlide, 6000);

  track?.addEventListener('mouseenter', () => clearInterval(autoplayInterval));
  track?.addEventListener('mouseleave', () => {
    autoplayInterval = setInterval(nextSlide, 6000);
  });
</script>
