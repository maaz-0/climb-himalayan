---
import Button from '../common/Button.astro';
import ScrollReveal from '../common/ScrollReveal.astro';
---

<section class="relative py-24 lg:py-32">
  <!-- Background Image -->
  <div
    class="absolute inset-0 bg-cover bg-center bg-fixed"
    style="background-image: url('https://images.unsplash.com/photo-1486870591958-9b9d0d1dda99?w=1920&q=80')"
  >
    <div class="absolute inset-0 bg-primary/80"></div>
  </div>

  <!-- Content -->
  <div class="relative mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
    <ScrollReveal animation="fade-up">
      <h2 class="text-3xl font-bold text-white sm:text-4xl lg:text-5xl">
        Ready for Your Himalayan Adventure?
      </h2>
      <p class="mx-auto mt-6 max-w-2xl text-lg text-gray-200">
        Let our experts help you plan the perfect trip. Whether you're a first-time
        trekker or an experienced mountaineer, we'll create an adventure tailored
        just for you.
      </p>
    </ScrollReveal>
    <ScrollReveal animation="fade-up" delay={150}>
      <div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <Button href="/contact" variant="primary" size="lg" class="btn-press pulse-subtle">
          Start Planning
        </Button>
        <Button href="/packages" variant="white" size="lg" class="btn-press">
          Browse Packages
        </Button>
      </div>
    </ScrollReveal>

    <!-- Trust Indicators -->
    <div class="mt-16 flex flex-wrap items-center justify-center gap-8 text-white/80">
      <div class="flex items-center gap-2">
        <svg
          class="h-6 w-6 text-accent"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.5"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M9 12.75L11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 01-1.043 3.296 3.745 3.745 0 01-3.296 1.043A3.745 3.745 0 0112 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 01-3.296-1.043 3.745 3.745 0 01-1.043-3.296A3.745 3.745 0 013 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 011.043-3.296 3.746 3.746 0 013.296-1.043A3.746 3.746 0 0112 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 013.296 1.043 3.746 3.746 0 011.043 3.296A3.745 3.745 0 0121 12z"
          ></path>
        </svg>
        <span class="text-sm font-medium">20+ Years Experience</span>
      </div>
      <div class="flex items-center gap-2">
        <svg
          class="h-6 w-6 text-accent"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.5"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z"
          ></path>
        </svg>
        <span class="text-sm font-medium">5000+ Happy Trekkers</span>
      </div>
      <div class="flex items-center gap-2">
        <svg
          class="h-6 w-6 text-accent"
          fill="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"
          ></path>
        </svg>
        <span class="text-sm font-medium">4.9/5 Average Rating</span>
      </div>
    </div>
  </div>
</section>
