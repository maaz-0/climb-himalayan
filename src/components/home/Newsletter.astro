---
import ScrollReveal from '../common/ScrollReveal.astro';
---

<section class="bg-primary py-16 lg:py-20">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <ScrollReveal animation="fade-up">
      <div class="flex flex-col items-center justify-between gap-8 lg:flex-row">
        <!-- Content -->
        <div class="text-center lg:text-left">
          <h2 class="text-2xl font-bold text-white sm:text-3xl">
            Stay Updated on New Adventures
          </h2>
          <p class="mt-2 text-gray-300">
            Get exclusive deals, trip updates, and mountain inspiration delivered
            to your inbox.
          </p>
        </div>

        <!-- Form -->
        <form
          class="flex w-full max-w-md flex-col gap-4 sm:flex-row"
          data-newsletter-form
        >
        <div class="relative flex-1">
          <input
            type="email"
            name="email"
            required
            placeholder="Enter your email"
            class="w-full rounded-full border-0 bg-white/10 px-6 py-4 text-white placeholder:text-gray-400 focus:bg-white/20 focus:outline-none focus:ring-2 focus:ring-accent"
          />
        </div>
        <button
          type="submit"
          class="rounded-full bg-accent px-8 py-4 font-semibold text-white transition-all hover:bg-accent-dark hover:shadow-lg focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-primary"
        >
          Subscribe
        </button>
      </form>
      </div>

      <!-- Privacy Note -->
      <p class="mt-6 text-center text-xs text-gray-400 lg:text-left">
        We respect your privacy. Unsubscribe at any time.
      </p>
    </ScrollReveal>
  </div>
</section>

<script>
  const form = document.querySelector('[data-newsletter-form]');

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const formData = new FormData(form as HTMLFormElement);
    const email = formData.get('email');

    // In a real implementation, you'd send this to your backend
    console.log('Newsletter signup:', email);

    // Show success message (for demo purposes)
    alert('Thank you for subscribing! You\'ll receive our latest updates soon.');
    (form as HTMLFormElement).reset();
  });
</script>
